{
  "name": "@openkeep/server",
  "version": "1.45.1",
  "private": true,
  "description": "OpenKeep API server (Fastify + Drizzle + pg-boss)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "gen:vapid": "tsx scripts/gen-vapid.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@fastify/swagger": "9.8.1",
    "@fastify/websocket": "11.3.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@openkeep/mcp": "workspace:*",
    "@openkeep/shared": "workspace:*",
    "archiver": "8.0.0",
    "better-auth": "1.6.30",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "fastify-type-provider-zod": "7.0.0",
    "nodemailer": "9.0.5",
    "pg": "8.23.0",
    "pg-boss": "12.28.0",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "rrule": "2.8.1",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.3",
    "undici": "8.10.0",
    "web-push": "3.6.7",
    "yauzl": "3.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@fastify/swagger-ui": "6.1.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@openkeep/config": "workspace:*",
    "@testcontainers/postgresql": "12.1.0",
    "@types/archiver": "8.0.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.1",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.1",
    "@types/yauzl": "3.4.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "ws": "8.21.3"
  }
}
